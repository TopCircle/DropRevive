// Public profile: what the Deploy to Cloudflare button and `npm run deploy` ship.
// A workers.dev Worker with no route; add your own domain in the Cloudflare dashboard
// (Workers > your Worker > Settings > Domains & Routes). See docs/self-host.md.
// `main`, `assets`, `no_bundle`, `rules` and `build` (bottom) only serve a bare `wrangler deploy` from a
// clean checkout: wrangler runs `npm run build` first, then uploads nitro's output. A build writes
// .output/server/wrangler.json (nitro overrides `main`/`assets` there; scripts/check-profile.mjs drops
// `build`), and every later `wrangler deploy` follows nitro's .wrangler/deploy/config.json redirect to it.
// The maintainer's production site is a build profile (DROP_PROFILE=production,
// scripts/wrangler-profile.mjs), not this file.
{
  "name": "droprevive",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Durable Object Workers get no version preview URLs anyway; keep the dashboard state explicit.
  "preview_urls": false,
  // No required secrets: deploy first, configure later. The six optional Worker secrets
  // (.dev.vars.example, docs/self-host.md) are added in the dashboard after the first deploy;
  // /setup shows which are set. LAN transfer works with none of them.
  "durable_objects": {
    "bindings": [
      { "name": "TRANSFER_ROOM", "class_name": "TransferRoom" },
      { "name": "TRANSFER_GATE", "class_name": "TransferGate" }
    ]
  },
  "migrations": [{ "tag": "v1-transfer-room", "new_sqlite_classes": ["TransferRoom", "TransferGate"] }],
  // Same values nitro writes into .output/server/wrangler.json (paths there are relative to it).
  "main": ".output/server/index.mjs",
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  // Wrangler custom build: when the Workers Builds build command is empty and the deploy command is
  // the default `npx wrangler deploy`, wrangler still builds the site before uploading it.
  "build": { "command": "npm run build" }
}
