// Public profile: what the Deploy to Cloudflare button and `npm run deploy` ship.
// A workers.dev Worker with no route; add your own domain in the Cloudflare dashboard
// (Workers > your Worker > Settings > Domains & Routes). See docs/self-host.md.
// Keep `main` and `assets` out of this file: nitro fills them into the generated config.
// The maintainer's production site is a build profile (DROP_PROFILE=production,
// scripts/wrangler-profile.mjs), not this file.
{
  "name": "droprevive",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Durable Object Workers get no version preview URLs anyway; keep the dashboard state explicit.
  "preview_urls": false,
  // The Deploy to Cloudflare form asks for these (descriptions: package.json "cloudflare.bindings";
  // template: .dev.vars.example). `wrangler deploy` refuses while any is unset on the Worker.
  // Enter `none` for a drive you do not use. See docs/self-host.md.
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "MS_CLIENT_ID",
      "MS_CLIENT_SECRET",
      "DRIVE_COOKIE_KEY",
      "ALLOWED_ORIGINS"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TRANSFER_ROOM", "class_name": "TransferRoom" },
      { "name": "TRANSFER_GATE", "class_name": "TransferGate" }
    ]
  },
  "migrations": [{ "tag": "v1-transfer-room", "new_sqlite_classes": ["TransferRoom", "TransferGate"] }]
}
